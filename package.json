{
  "name": "@civ-clone/library-diplomacy",
  "version": "0.1.5",
  "description": "A library of diplomacy items for any rule set: declarations (peace, war, ceasefire, alliance, sham peace, vendetta), interactions and proposals, and the MayNegotiate and Pacified rules.",
  "repository": "git@github.com:civ-clone/library-diplomacy.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-civilization": "^0.1.9",
    "@civ-clone/core-game": "^0.1.17",
    "@civ-clone/core-save-game": "^0.1.23",
    "@civ-clone/core-world": "^0.1.24",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-city-yield-gold": "^0.1.0",
    "@civ-clone/base-diplomacy-declaration-alliance": "^0.1.0",
    "@civ-clone/base-diplomacy-declaration-ceasefire": "^0.1.0",
    "@civ-clone/base-diplomacy-declaration-peace": "^0.1.0",
    "@civ-clone/base-diplomacy-declaration-war": "^0.1.0",
    "@civ-clone/base-diplomacy-interaction-contact": "^0.1.0",
    "@civ-clone/core-diplomacy": "^0.1.9",
    "@civ-clone/core-player": "^0.1.7",
    "@civ-clone/core-rule": "^0.1.3",
    "@civ-clone/core-science": "^0.1.4",
    "@civ-clone/core-treasury": "^0.1.4",
    "@civ-clone/core-turn-based-game": "^0.1.0",
    "@civ-clone/core-unit": "^0.1.0"
  }
}
